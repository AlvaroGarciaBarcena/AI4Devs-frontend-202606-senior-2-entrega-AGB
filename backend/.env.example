DB_PASSWORD=changeme
DB_USER=LTIdbUser
DB_NAME=LTIdb
DB_PORT=5432
# El paquete `dotenv` que usa este proyecto (a diferencia de `dotenv-expand`,
# no instalado) no interpola ${DB_USER} etc. dentro de este mismo fichero —
# copiar esta plantilla tal cual produciría un DATABASE_URL con las llaves
# literales sin resolver. Escribe aquí los mismos valores de arriba, ya
# resueltos, sin variables:
DATABASE_URL="postgresql://LTIdbUser:changeme@localhost:5432/LTIdb"

# Clave usada para firmar los JWT de sesión (ver src/application/services/authService.ts).
# Genera una propia para cada entorno, nunca reutilices esta ni la subas a git:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme

# Orígenes permitidos por CORS, separados por comas (ver src/corsOptions.ts).
# Por defecto, si no se define esta variable, solo se permite
# http://localhost:3000. Añade aquí el origen real desde el que accedas si
# no es ese -- por ejemplo, para entrar desde otro equipo de tu red local
# por la IP del servidor (recuerda arrancar también el frontend con
# `vite --host` o `host: true` en vite.config.ts, si no, no escuchará fuera
# de tu propia máquina aunque el origen esté permitido aquí):
# CORS_ORIGINS=http://localhost:3000,http://192.168.1.50:3000
